---
import BaseHead from '../../components/BaseHead.astro';
import AccountHub from '../../components/AccountHub.jsx';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Your account" description="Manage your BigfootDS sign-in and profile." />
	</head>
	<body>
		<Header />
		<main>
			<AccountHub
				client:load
				accountsBaseUrl={import.meta.env.PUBLIC_MS_ACCOUNTS_BASE_URL}
				authBaseUrl={import.meta.env.PUBLIC_MS_AUTH_BASE_URL}
			/>
		</main>
		<Footer />
	</body>
</html>
