---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PasswordResetRequestPanel from '../../../components/PasswordResetRequestPanel.jsx';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Reset your password" description="Request a BigfootDS password-reset link." />
		<meta name="referrer" content="no-referrer" />
	</head>
	<body>
		<Header />
		<main>
			<PasswordResetRequestPanel client:only="react" apiBaseUrl={import.meta.env.PUBLIC_MS_AUTH_BASE_URL} />
			<noscript>
				<p>Password reset needs JavaScript to send a secure request. Please enable JavaScript and try again.</p>
			</noscript>
		</main>
		<Footer />
	</body>
</html>
