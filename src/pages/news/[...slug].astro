---
import { getGeneratedPublicNews } from '../../lib/public-news.mjs';
import { getPublishedLegacyNewsRedirects } from '../../lib/news-legacy-redirects.mjs';

export async function getStaticPaths() {
	return getPublishedLegacyNewsRedirects(await getGeneratedPublicNews()).map((redirect) => ({
		params: { slug: redirect.slug },
		props: { target: redirect.target },
	}));
}
const { target } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Article moved | BigfootDS</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
  </head>
  <body><main><h1>Article moved</h1><p><a href={target}>Read this article on News</a>.</p></main></body>
</html>
