---
import { serialiseJsonForScript } from '../../lib/json-for-script.mjs';

interface Props {
	heroImage?: string;
	pubDate?: Date;
	title?: string;
	updatedDate?: Date;
}

const { title, heroImage, pubDate, updatedDate } = Astro.props as Props;
const article = title && pubDate
	? {
		"@context": "https://schema.org",
		"@type": "NewsArticle",
		author: [{
			"@type": "Person",
			name: "BigfootDS",
			url: "https://bigfootds.com/about/"
		}],
		datePublished: pubDate.toISOString(),
		...(updatedDate === undefined ? {} : { dateModified: updatedDate.toISOString() }),
		headline: title,
		...(heroImage === undefined ? {} : { image: [new URL(heroImage, Astro.site).toString()] })
	}
	: undefined;
---

{
	article !== undefined && (
		<script type="application/ld+json" is:inline set:html={serialiseJsonForScript(article)}></script>
	)
}
