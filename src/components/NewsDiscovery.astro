---
import { getNewsFilterOptions } from '../lib/news-discovery.mjs';
import { serialiseJsonForScript } from '../lib/json-for-script.mjs';
import FormattedDate from './FormattedDate.astro';

interface PublicNewsPost {
	category: string;
	content: {
		body: string;
		locale: string;
		summary: string;
		title: string;
	};
	id: string;
	projectId: string;
	publishAt: string;
	tags: readonly string[];
}

const { posts } = Astro.props as { posts: readonly PublicNewsPost[] };
const options = getNewsFilterOptions(posts);
const serialisedPosts = serialiseJsonForScript(posts);
---

<section class="news-discovery" aria-labelledby="news-discovery-heading">
	<h1 id="news-discovery-heading">News</h1>
	<p>Browse published BigfootDS news, or narrow the list by project, category, tag, or text.</p>

	<form id="news-filters" action="/news/" method="get">
		<div class="filter-field filter-field-wide">
			<label for="news-query">Search news</label>
			<input id="news-query" name="q" type="search" maxlength="120" autocomplete="off" />
		</div>
		<div class="filter-field">
			<label for="news-project">Project</label>
			<select id="news-project" name="project">
				<option value="">All projects</option>
				{options.projects.map((project) => <option value={project}>{project}</option>)}
			</select>
		</div>
		<div class="filter-field">
			<label for="news-category">Category</label>
			<select id="news-category" name="category">
				<option value="">All categories</option>
				{options.categories.map((category) => <option value={category}>{category}</option>)}
			</select>
		</div>
		<div class="filter-field">
			<label for="news-tag">Tag</label>
			<select id="news-tag" name="tag">
				<option value="">All tags</option>
				{options.tags.map((tag) => <option value={tag}>{tag}</option>)}
			</select>
		</div>
		<div class="filter-actions">
			<button type="submit">Apply filters</button>
			<a href="/news/" id="news-clear-filters">Clear filters</a>
		</div>
	</form>

	<p id="news-result-count" aria-live="polite"></p>
	<p id="news-empty-state" hidden>No published news matches those filters. Try clearing a filter or searching for something else.</p>
	<noscript><p>News search and filters need JavaScript because this is a static site. All published news is still listed below.</p></noscript>

	<ul id="news-results">
		{
			posts.map((post) => (
				<li data-news-id={post.id}>
					<article>
						<p class="news-meta"><FormattedDate date={new Date(post.publishAt)} /> · {post.category}</p>
						<h2><a href={`/news/${post.id}/`}>{post.content.title}</a></h2>
						<p>{post.content.summary}</p>
						<p class="news-tags">{post.tags.map((tag) => <span>#{tag}</span>)}</p>
						<p class="news-source">MS-News source: <code>{post.id}</code></p>
					</article>
				</li>
			))
		}
	</ul>
</section>

<script id="news-publication-data" type="application/json" is:inline set:html={serialisedPosts}></script>
<script>
	import { filterPublicNews, readNewsFilters, serialiseNewsFilters } from '../lib/news-discovery.mjs';

	type NewsFilters = { category?: string; project?: string; q?: string; tag?: string };
	type PublicNewsPost = {
		category: string;
		content: { body: string; summary: string; title: string };
		id: string;
		projectId: string;
		tags: readonly string[];
	};

	function requireElement<T extends Element>(selector: string): T {
		const element = document.querySelector<T>(selector);

		if (element === null) {
			throw new Error(`The news discovery control ${selector} could not be initialised.`);
		}

		return element;
	}

	const form = requireElement<HTMLFormElement>('#news-filters');
	const query = requireElement<HTMLInputElement>('#news-query');
	const project = requireElement<HTMLSelectElement>('#news-project');
	const category = requireElement<HTMLSelectElement>('#news-category');
	const tag = requireElement<HTMLSelectElement>('#news-tag');
	const clear = requireElement<HTMLAnchorElement>('#news-clear-filters');
	const resultCount = requireElement<HTMLElement>('#news-result-count');
	const emptyState = requireElement<HTMLElement>('#news-empty-state');
	const data = requireElement<HTMLScriptElement>('#news-publication-data');

	const cards = new Map(
		[...document.querySelectorAll<HTMLElement>('[data-news-id]')]
			.map((card) => [card.dataset.newsId ?? '', card])
	);
	const posts = JSON.parse(data.textContent ?? '[]') as readonly PublicNewsPost[];

	function render(filters: NewsFilters) {
		query.value = filters.q ?? '';
		project.value = filters.project ?? '';
		category.value = filters.category ?? '';
		tag.value = filters.tag ?? '';

		const matchingPosts = filterPublicNews(posts, filters);
		const matchingIds = new Set(matchingPosts.map((post) => post.id));

		for (const [id, card] of cards) {
			card.hidden = !matchingIds.has(id);
		}

		resultCount.textContent = `${matchingPosts.length} published ${matchingPosts.length === 1 ? 'post' : 'posts'} found.`;
		emptyState.hidden = matchingPosts.length !== 0;
		clear.hidden = serialiseNewsFilters(filters).size === 0;
	}

	function updateUrl(filters: NewsFilters) {
		const parameters = serialiseNewsFilters(filters);
		const queryString = parameters.toString();
		history.pushState({}, '', queryString === '' ? '/news/' : `/news/?${queryString}`);
	}

	function filtersFromLocation() {
		return readNewsFilters(new URLSearchParams(window.location.search));
	}

	form.addEventListener('submit', (event) => {
		event.preventDefault();
		const filters = readNewsFilters(new URLSearchParams({
			category: category.value,
			project: project.value,
			q: query.value,
			tag: tag.value
		}));
		updateUrl(filters);
		render(filters);
	});

	clear.addEventListener('click', (event) => {
		event.preventDefault();
		form.reset();
		updateUrl({});
		render({});
	});

	window.addEventListener('popstate', () => render(filtersFromLocation()));
	render(filtersFromLocation());
</script>

<style>
	.news-discovery {
		max-width: 960px;
		margin: 0 auto;
	}

	form {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		padding: 1rem;
		border: 1px solid var(--theme-700);
		border-radius: 0.5rem;
	}

	.filter-field {
		display: grid;
		gap: 0.25rem;
	}

	.filter-field-wide {
		grid-column: span 2;
	}

	input,
	select,
	button {
		min-height: 2.5rem;
		font: inherit;
	}

	.filter-actions {
		display: flex;
		align-items: end;
		gap: 1rem;
		grid-column: span 2;
	}

	#news-results {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1rem;
		padding: 0;
		list-style: none;
	}

	#news-results article {
		height: 100%;
		padding: 1rem;
		border: 1px solid var(--theme-700);
		border-radius: 0.5rem;
	}

	.news-meta,
	.news-source,
	.news-tags {
		font-size: 0.85em;
	}

	.news-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	@media (max-width: 720px) {
		form,
		.filter-field-wide,
		.filter-actions {
			grid-column: auto;
			grid-template-columns: 1fr;
		}
	}
</style>
