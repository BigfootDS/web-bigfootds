---
import BaseHead from '../../../../components/BaseHead.astro';
import StaffNewsComposer from '../../../../components/StaffNewsComposer.jsx';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="News editor" description="Staff-only BigfootDS News editor." />
	</head>
	<body>
		<main class="staff-news-page">
			<StaffNewsComposer client:load apiBaseUrl={import.meta.env.PUBLIC_MS_NEWS_BASE_URL} authBaseUrl={import.meta.env.PUBLIC_MS_AUTH_BASE_URL} />
		</main>
	</body>
</html>

<style is:global>
	main.staff-news-page {
		width: min(78rem, calc(100% - 2em));
	}
</style>
