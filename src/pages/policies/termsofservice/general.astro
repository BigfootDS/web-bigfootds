---
import Layout from "../../../layouts/BlogPost.astro";
import aboutHeader from "../../../assets/images/headers/AstroAboutHeader.png";
---

<Layout
	title="BigfootDS General Terms of Service"
	description="The general terms that apply when you use BigfootDS websites, games, software, and connected services."
	heroImage={aboutHeader.src}
>

	<section id="policy">
		<h1>General Terms of Service for BigfootDS</h1>
		<span class="ppg-effdate"
