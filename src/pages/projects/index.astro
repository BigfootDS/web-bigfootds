---
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectDiscovery from '../../components/ProjectDiscovery.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { createProjectDiscoveryIndex } from '../../lib/project-discovery.mjs';

const projectEntries = await getCollection('projectPages');
const projects = createProjectDiscoveryIndex(projectEntries.map((project) => ({
	description: project.data.description,
	id: project.id,
	publishedAt: project.data.pubDate,
	title: project.data.title
})));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<ProjectDiscovery projects={projects} />
		</main>
		<Footer />
	</body>
</html>
