---
import { serialiseJsonForScript } from '../../lib/json-for-script.mjs';
import { createNewsArticleStructuredData } from '../../lib/news-article-structured-data.mjs';

interface Props {
	heroImage?: string;
	isNewsArticle?: boolean;
	pubDate?: Date;
	title?: string;
	updatedDate?: Date;
}

const { title, heroImage, isNewsArticle, pubDate, updatedDate } = Astro.props as Props;
const article = createNewsArticleStructuredData({
	...(heroImage === undefined ? {} : { heroImage: new URL(heroImage, Astro.site).toString() }),
	isNewsArticle,
	pubDate,
	title,
	updatedDate
});
---

{
	article !== undefined && (
		<script type="application/ld+json" is:inline set:html={serialiseJsonForScript(article)}></script>
	)
}
