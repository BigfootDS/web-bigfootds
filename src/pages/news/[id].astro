---
import BlogPost from '../../layouts/BlogPost.astro';
import RichNewsContent from '../../components/RichNewsContent.astro';
import { getGeneratedPublicNewsSnapshot } from '../../lib/public-news.mjs';

export async function getStaticPaths() {
	const snapshot = await getGeneratedPublicNewsSnapshot();

	return snapshot.posts.map((post) => ({
		params: { id: post.id },
		props: { mediaDeliveryBaseUrl: snapshot.mediaDeliveryBaseUrl, post },
	}));
}

const { mediaDeliveryBaseUrl, post } = Astro.props;
---

<BlogPost
	isNewsArticle={true}
	title={post.content.title}
	description={post.content.summary}
	pubDate={new Date(post.publishAt)}
>
	<p class="news-source">Published from MS-News source <code>{post.id}</code> in {post.content.locale}.</p>
	<p class="news-tags">{post.tags.map((tag) => <span>#{tag}</span>)}</p>
	{post.content.document === undefined ? (
		<div class="news-body">{post.content.body}</div>
	) : (
		<RichNewsContent document={post.content.document} mediaDeliveryBaseUrl={mediaDeliveryBaseUrl} />
	)}
</BlogPost>

<style>
	.news-source,
	.news-tags {
		font-size: 0.85em;
	}

	.news-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.news-body {
		white-space: pre-wrap;
	}
</style>
