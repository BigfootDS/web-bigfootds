---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import AccountRegistrationPanel from '../../../components/AccountRegistrationPanel.jsx';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Create your account" description="Create a BigfootDS account and verify your email address." />
    <meta name="referrer" content="no-referrer" />
  </head>
  <body>
    <Header />
    <main>
      <AccountRegistrationPanel client:only="react" apiBaseUrl={import.meta.env.PUBLIC_MS_AUTH_BASE_URL} />
      <noscript><p>Account creation needs JavaScript to send a secure request. Please enable JavaScript and try again.</p></noscript>
    </main>
    <Footer />
  </body>
</html>
