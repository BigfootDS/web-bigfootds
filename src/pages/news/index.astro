---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import NewsDiscovery from '../../components/NewsDiscovery.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getGeneratedPublicNews } from '../../lib/public-news.mjs';

const posts = await getGeneratedPublicNews();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="News" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<NewsDiscovery posts={posts} />
		</main>
		<Footer />
	</body>
</html>
